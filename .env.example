# .env.example
# Local dev (npm run dev): put these in a .env file at the project root.
# Netlify deploy: set the same keys under Site configuration -> Environment variables.
GEMINI_API_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# SERVER-SIDE ONLY -- used by netlify/functions/admin-create-user.ts and
# admin-delete-user.ts to manage accounts. Never prefix this with VITE_ --
# that would bundle it into the public JS file shipped to every visitor's
# browser, giving anyone full admin access to your database.
SUPABASE_SERVICE_ROLE_KEY=

# SERVER-SIDE ONLY -- used by netlify/functions/send-notification-email.ts
# to actually deliver inquiry/scholarship-application emails to
# insight@aviyana.lk (instead of relying on a mailto: link). Get a free key
# at https://resend.com/api-keys. RECIPIENT_EMAIL and SENDER_EMAIL are
# optional (they default to insight@aviyana.lk and Resend's shared sending
# address, which works immediately with no domain setup).
RESEND_API_KEY=
RECIPIENT_EMAIL=
SENDER_EMAIL=

